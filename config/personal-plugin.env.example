# Personal Browser Client integrity expectation. Not a host trust grant.
# Default: unset. Explicit --expected-browser-client-sha256 takes precedence.
# Set this only to the SHA-256 of an independently reviewed release artifact:
# export BOSS_PLUGIN_EXPECTED_BROWSER_CLIENT_SHA256="<64 hexadecimal characters>"
# bun components/electron-app/bin/reconcile-native-host.mjs --dry-run --json
# Do not map this value into NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S.
# User data root is selected via --codex-home, then CODEX_HOME, then ~/.codex.

# Optional runtime overrides for nonstandard Desktop installations.
# Both values must be absolute paths. Normal macOS installs are discovered automatically.
# export BOSS_PLUGIN_NODE_REPL_PATH="/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl"
# export BOSS_PLUGIN_NODE_PATH="/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"
